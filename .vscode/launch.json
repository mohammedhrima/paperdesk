{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (hot reload)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "dev"
    },
    {
      "name": "Run Extension (production build)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "build",
      "env": { "PAPERDESK_FORCE_PRODUCTION": "1" }
    }
  ]
}
