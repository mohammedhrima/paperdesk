{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "paperdesk",
        "pattern": { "regexp": "^✘ \\[ERROR\\] (.+?):(\\d+):(\\d+): (.*)$", "file": 1, "line": 2, "column": 3, "message": 4 },
        "background": {
          "activesBegin": "\\[host\\] build started",
          "endsPattern": "\\[host\\] build finished"
        }
      },
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    }
  ]
}
